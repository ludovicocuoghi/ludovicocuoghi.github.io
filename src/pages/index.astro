---
import '../styles/global.css';
import { experience, featuredProjects, links, moreProjects } from '../data/site';

const title = 'Ludovico Cuoghi — Data Scientist';
const description = 'Ludovico Cuoghi is a Data Scientist II at QuantumBlack, AI by McKinsey in Tokyo. He builds AI agents and end-to-end applications for clients.';
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ludovicocuoghi.github.io/" />
    <meta property="og:image" content="https://ludovicocuoghi.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://ludovicocuoghi.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('portfolio-theme') || 'dark';
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="nav-shell">
        <a class="brand" href="#top">Ludovico Cuoghi</a>
        <nav class="nav-links" id="site-nav" aria-label="Main navigation">
          <a href="#work">Work</a>
          <a href="#experience">Experience</a>
          <a href="#projects">Projects</a>
          <a href="#about">About</a>
          <a href="#contact">Contact</a>
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to light theme">
            <span aria-hidden="true">◐</span><span class="theme-label">Theme</span>
          </button>
          <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open navigation">
            <span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <p class="eyebrow">DATA SCIENTIST · TOKYO</p>
        <h1 id="hero-title">Ludovico Cuoghi</h1>
        <p class="hero-role">Data Scientist II at QuantumBlack, AI by McKinsey</p>
        <p class="hero-intro">I design and build AI agents and end-to-end applications for clients, from architecture and data pipelines to evaluation and deployment. I focus on reliability and reducing hallucinations.</p>
        <div class="hero-actions">
          <a class="button" href="#work">View projects <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section-shell content-section" id="work" aria-labelledby="work-title">
        <div class="section-heading">
          <div><p class="eyebrow">01 / WORK</p><h2 id="work-title">Selected work</h2></div>
          <p>Public projects in machine learning, data analysis, and software development.</p>
        </div>
        <div class="featured-grid">
          {featuredProjects.map((project) => (
            <article class="feature-card">
              <p class="feature-meta">{project.number} / {project.category}</p>
              <h3>{project.title}</h3>
              <p class="feature-description">{project.description}</p>
              <ul class="tag-list" aria-label="Technologies">
                {project.stack.map((item) => <li>{item}</li>)}
              </ul>
              <a class="card-link" href={project.url} target="_blank" rel="noopener noreferrer">
                {project.linkText} <span aria-hidden="true">↗</span>
              </a>
            </article>
          ))}
        </div>
      </section>

      <section class="experience-band" id="experience" aria-labelledby="experience-title">
        <div class="section-shell content-section">
          <div class="section-heading">
            <div><p class="eyebrow">02 / CAREER</p><h2 id="experience-title">Experience</h2></div>
            <p>Data science roles in Japan since 2022.</p>
          </div>
          <div class="timeline">
            {experience.map((job) => (
              <article class="timeline-row">
                <span class="timeline-period">{job.period}</span>
                <div><h3>{job.role}</h3><p>{job.company} · {job.location}</p></div>
                <p class="timeline-summary">{job.summary}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section-shell content-section" id="projects" aria-labelledby="projects-title">
        <div class="section-heading">
          <div><p class="eyebrow">03 / PROJECTS</p><h2 id="projects-title">Other projects</h2></div>
          <p>Selected notebooks. More work is available on GitHub and Kaggle.</p>
        </div>
        <div class="project-list">
          {moreProjects.map((project, index) => (
            <a class="project-row" href={project.url} target="_blank" rel="noopener noreferrer">
              <span class="project-index">0{index + 1}</span>
              <span class="project-name">{project.title}</span>
              <span class="project-type">{project.type}</span>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <div class="all-links">
          <a class="text-link" href={links.github} target="_blank" rel="noopener noreferrer">All GitHub projects ↗</a>
          <a class="text-link" href={links.kaggle} target="_blank" rel="noopener noreferrer">All Kaggle work ↗</a>
        </div>
      </section>

      <section class="about-band" id="about" aria-labelledby="about-title">
        <div class="section-shell about-grid">
          <div><p class="eyebrow">04 / ABOUT</p><h2 id="about-title">Background</h2></div>
          <div class="about-copy">
            <p>I’m an Italian data scientist based in Tokyo. I currently work at QuantumBlack, AI by McKinsey.</p>
            <p>I studied control engineering at Politecnico di Milano and completed a double master’s degree with Keio University. My work spans AI applications, software architecture, data engineering, and model evaluation.</p>
            <p class="about-languages">Languages: Italian, English, Japanese.</p>
          </div>
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <div class="section-shell contact-inner">
          <p class="eyebrow">05 / CONTACT</p>
          <h2 id="contact-title">Contact</h2>
          <p>For work or project inquiries, contact me by email or connect on LinkedIn.</p>
          <a class="button contact-button" href={links.email}>Email me <span aria-hidden="true">↗</span></a>
          <div class="contact-links">
            <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
            <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href={links.kaggle} target="_blank" rel="noopener noreferrer">Kaggle ↗</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="section-shell footer-inner">
        <span>© {new Date().getFullYear()} Ludovico Cuoghi</span>
        <span>Tokyo, Japan</span>
        <a href="#top">Back to top ↑</a>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');

      function updateThemeLabel() {
        themeButton?.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
      }
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('portfolio-theme', root.dataset.theme); } catch {}
        updateThemeLabel();
      });

      function closeMenu() {
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation');
        nav?.classList.remove('is-open');
      }
      menuButton?.addEventListener('click', () => {
        const open = menuButton.getAttribute('aria-expanded') !== 'true';
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        nav?.classList.toggle('is-open', open);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
    </script>
  </body>
</html>
