---
import '../styles/global.css';
import { experience, featuredProjects, links, moreProjects } from '../data/site';

const pageTitle = 'Ludovico Cuoghi — Data Scientist';
const pageDescription = 'Ludovico Cuoghi is a Data Scientist II at QuantumBlack, AI by McKinsey in Tokyo. Experience in machine learning, data engineering, and RAG.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f8f9fc" />
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content="https://ludovicocuoghi.github.io/" />
    <meta property="og:image" content="https://ludovicocuoghi.github.io/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://ludovicocuoghi.github.io/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('theme');
        document.documentElement.dataset.theme = savedTheme || 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header" id="top">
      <div class="nav-shell">
        <a class="brand" href="#top" aria-label="Ludovico Cuoghi, back to top"><span class="brand-name">Ludovico Cuoghi</span></a>
        <nav class="nav-links" id="site-nav" aria-label="Main navigation">
          <a href="#work">Work</a><a href="#experience">Experience</a><a href="#projects">Projects</a><a href="#about">About</a><a href="#contact">Contact</a>
        </nav>
        <div class="nav-actions">
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Change theme"><span class="theme-icon" aria-hidden="true">◐</span><span class="theme-label">Theme</span></button>
          <button class="menu-toggle" type="button" aria-controls="site-nav" aria-expanded="false" aria-label="Open navigation"><span></span><span></span></button>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero section-shell" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">DATA SCIENTIST · TOKYO</p>
          <h1 id="hero-title">Ludovico Cuoghi</h1>
          <p class="hero-role">Data Scientist II at QuantumBlack, AI by McKinsey</p>
          <p class="hero-intro">I work on machine learning, data engineering, and retrieval-augmented generation.</p>
          <div class="hero-actions"><a class="button button-primary" href="#work">View projects <span aria-hidden="true">↗</span></a><a class="text-link" href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a></div>
        </div>
        <div class="hero-index" aria-label="Profile summary">
          <div><span>01 / CURRENT</span><strong>QuantumBlack,<br />AI by McKinsey</strong></div>
          <div><span>02 / LOCATION</span><strong>Tokyo, Japan</strong></div>
          <div><span>03 / FOCUS</span><strong>Machine learning<br />and data systems</strong></div>
        </div>
      </section>

      <section class="section-shell content-section" id="work" aria-labelledby="work-title">
        <div class="section-heading"><div><p class="eyebrow">01 / SELECTED WORK</p><h2 id="work-title">Selected work<span class="period">.</span></h2></div><p class="section-description">Public projects in machine learning, data analysis, and software development.</p></div>
        <div class="featured-grid">
          {featuredProjects.map((project) => <article class={`feature-card feature-${project.visual}`}>
            <div class="feature-visual" aria-hidden="true">
              {project.visual === 'retrieval' && <div class="retrieval-graphic"><span class="query-node">QUESTION</span><span class="flow-line"></span><span class="result-node">SEARCH</span><span class="flow-line"></span><span class="result-node highlighted">RERANK</span><span class="flow-line"></span><span class="answer-node">ANSWER ↗</span></div>}
              {project.visual === 'kaggle' && <div class="kaggle-graphic"><span class="graph-baseline"></span><span class="graph-bar bar-one"></span><span class="graph-bar bar-two"></span><span class="graph-bar bar-three"></span><span class="graph-bar bar-four"></span><span class="graph-bar bar-five"></span><span class="graph-bar bar-six"></span><span class="graph-caption">EXPLORE / EXPERIMENT / LEARN</span></div>}
              {project.visual === 'rome' && <div class="rome-graphic"><span class="rome-sun"></span><span class="rome-arch arch-one"></span><span class="rome-arch arch-two"></span><span class="rome-ground"></span><span class="rome-caption">ANOTHER TIME. ANOTHER ROME.</span></div>}
            </div>
            <div class="feature-body"><div class="feature-meta"><span>{project.number} / {project.category}</span><span aria-hidden="true">↗</span></div><h3>{project.title}</h3><p>{project.description}</p><ul class="tag-list" aria-label="Technologies">{project.stack.map((item) => <li>{item}</li>)}</ul><a class="card-link" href={project.url} target="_blank" rel="noopener noreferrer">{project.linkText}<span aria-hidden="true">↗</span></a></div>
          </article>)}
        </div>
      </section>

      <section class="experience-band" id="experience" aria-labelledby="experience-title"><div class="section-shell content-section"><div class="section-heading"><div><p class="eyebrow">02 / EXPERIENCE</p><h2 id="experience-title">Experience<span class="period">.</span></h2></div><p class="section-description">Data science roles in Japan since 2022.</p></div><div class="timeline">{experience.map((job) => <article class="timeline-row"><div class="timeline-period">{job.period}</div><div class="timeline-main"><h3>{job.role}</h3><p>{job.company} <span class="location-dot">·</span> {job.location}</p></div><p class="timeline-summary">{job.summary}</p></article>)}</div></div></section>

      <section class="section-shell content-section" id="projects" aria-labelledby="projects-title"><div class="section-heading"><div><p class="eyebrow">03 / EXPLORATIONS</p><h2 id="projects-title">Other projects<span class="period">.</span></h2></div><p class="section-description">Selected notebooks. More work is available on GitHub and Kaggle.</p></div><div class="project-list">{moreProjects.map((project, index) => <a class="project-row" href={project.url} target="_blank" rel="noopener noreferrer"><span class="project-index">0{index + 1}</span><span class="project-name">{project.title}</span><span class="project-type">{project.type}</span><span class="project-arrow" aria-hidden="true">↗</span></a>)}</div><div class="all-links"><a class="text-link" href={links.github} target="_blank" rel="noopener noreferrer">All GitHub projects <span aria-hidden="true">↗</span></a><a class="text-link" href={links.kaggle} target="_blank" rel="noopener noreferrer">All Kaggle work <span aria-hidden="true">↗</span></a></div></section>

      <section class="about-band" id="about" aria-labelledby="about-title"><div class="section-shell about-grid"><div><p class="eyebrow">04 / A LITTLE ABOUT ME</p><h2 id="about-title">Background<span class="period">.</span></h2></div><div class="about-copy"><p>I’m an Italian data scientist based in Tokyo. I currently work at QuantumBlack, AI by McKinsey.</p><p>I studied control engineering at <strong>Politecnico di Milano</strong> and completed a double master’s degree with <strong>Keio University</strong>. My work has included predictive models, recommendation systems, data pipelines, and language models.</p><div class="about-details"><div><span class="detail-label">BASE</span><strong>Tokyo, Japan</strong></div><div><span class="detail-label">LANGUAGES</span><strong>Italian · English · Japanese</strong></div></div></div></div></section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title"><div class="section-shell contact-inner"><p class="eyebrow">05 / GET IN TOUCH</p><h2 id="contact-title">Contact<span class="period">.</span></h2><p>For work or project inquiries, contact me by email or connect on LinkedIn.</p><a class="contact-email" href={links.email}>Email me <span aria-hidden="true">↗</span></a><div class="contact-links"><a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={links.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a><a href={links.kaggle} target="_blank" rel="noopener noreferrer">Kaggle ↗</a></div></div></section>
    </main>
    <footer class="site-footer"><div class="section-shell footer-inner"><span>© {new Date().getFullYear()} Ludovico Cuoghi</span><span>Tokyo, Japan</span><a href="#top">Back to top ↑</a></div></footer>
    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('#site-nav');

      function updateThemeLabel() {
        if (themeButton) themeButton.setAttribute('aria-label', `Switch to ${root.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
      }
      updateThemeLabel();
      themeButton?.addEventListener('click', () => {
        root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch {}
        updateThemeLabel();
      });

      function closeMenu() {
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation');
        nav?.classList.remove('is-open');
      }
      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        menuButton.setAttribute('aria-label', isOpen ? 'Open navigation' : 'Close navigation');
        nav?.classList.toggle('is-open', !isOpen);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      document.addEventListener('click', (event) => { if (!event.target || !(event.target instanceof Node)) return; if (!nav?.contains(event.target) && !menuButton?.contains(event.target)) closeMenu(); });
    </script>
  </body>
</html>
